# Heartfelt settings. ./setup.sh copies this to .env and fills it in for you.

# Your public domain, e.g. cards.example.com.
# Set it and Heartfelt is served over HTTPS with a free, auto-renewing certificate.
# Leave it empty to run on this computer only (http://localhost:3000).
DOMAIN=

# Secret for moderating cards (see README). setup.sh generates one.
ADMIN_TOKEN=

# Optional: remove the # in front of a line to change it.
# Cards one visitor can create per 15 minutes
# CREATE_LIMIT=10
# Uploads pause once this much disk is used
# MAX_STORAGE_MB=2048
# Reports from different people that hide a card from the Love wall
# REPORT_HIDE_AT=3
# PORT=3000
